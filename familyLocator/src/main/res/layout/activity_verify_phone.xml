<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgApp"
    tools:context=".activity.VerifyPhoneActivity">

    <!-- Gradient Header Banner -->
    <View
        android:id="@+id/headerGradient"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@drawable/bg_gradient_header"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- App Logo / Icon -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/family_logo"
        android:contentDescription="@string/app_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Verification Code"
        android:textColor="@color/textWhite"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgLogo" />

    <!-- Verification Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardVerify"
        style="@style/ModernCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="-24dp"
        android:layout_marginEnd="20dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/headerGradient">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter 6-Digit OTP"
                android:textColor="@color/textPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textView1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="We have sent an SMS with a 6-digit verification code to your mobile number."
                android:textColor="@color/textSecondary"
                android:textSize="13sp" />

            <!-- OTP Input Box -->
            <EditText
                android:id="@+id/editTextCode"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_otp_box"
                android:digits="0123456789"
                android:gravity="center"
                android:hint="• • • • • •"
                android:inputType="number"
                android:letterSpacing="0.4"
                android:maxLength="6"
                android:textColor="@color/colorPrimaryDark"
                android:textColorHint="@color/textMuted"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Resend OTP Timer / Action -->
            <TextView
                android:id="@+id/txt_resend_otp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_status_active"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                android:text="Resend OTP"
                android:textColor="@color/colorSuccess"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Sign In Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonSignIn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_gradient_button"
                android:text="Verify &amp; Continue"
                android:textAllCaps="false"
                android:textColor="@color/textWhite"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Loading Spinner -->
            <ProgressBar
                android:id="@+id/progressbar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="16dp"
                android:indeterminateTint="@color/colorPrimary"
                android:visibility="gone" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>