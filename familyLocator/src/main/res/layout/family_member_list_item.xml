<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardCornerRadius="5dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ll_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="2dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/family_mbr_list_profilepic"
                android:layout_width="70dp"
                android:layout_height="60dp"
                android:layout_marginTop="2dp"
                android:layout_gravity="center"
                android:src="@drawable/blank_profile_picture"
                android:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:orientation="vertical"
                android:padding="0dp">

                <TextView
                    android:id="@+id/family_mbr_list_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="@dimen/margin_top"
                    android:layout_weight="1"
                    android:gravity="top"
                    android:maxLength="25"
                    android:text="chceckkkk"
                    android:textAllCaps="true"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/family_mbr_list_mobile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_weight="1"
                    android:text="9700567735"
                    android:textColor="@color/colorPrimary" />


                <TextView
                    android:id="@+id/family_mbr_list_relation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/family_mbr_list_mobile"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="@dimen/margin_top"
                    android:layout_weight="1"
                    android:text="its me"
                    android:textColor="@color/colorPrimaryDark"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/family_mbr_list_gps_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/family_mbr_list_mobile"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="5dp"
                    android:layout_weight="1"
                    android:gravity="left"
                    android:maxLines="2"
                    android:text="hhhhhhh"
                    android:textColor="@android:color/holo_red_dark"
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:visibility="gone" />


            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ll_txt">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/family_mbr_list_call"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@color/colorPrimary"
                android:gravity="center"
                android:text="Call"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:visibility="visible"
                app:srcCompat="@drawable/icon_call" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/family_mbr_list_msg"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@color/colorPrimary"
                android:gravity="center"
                android:text="Message"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:visibility="visible" />

            <TextView
                android:id="@+id/family_mbr_list_invite"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@color/colorPrimary"
                android:gravity="center"
                android:text="Invite"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:visibility="visible" />
        </LinearLayout>
    </RelativeLayout>

</androidx.cardview.widget.CardView>